{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicPack Author",
  "version": "0.1.0",
  "identifier": "dev.musicpack.author",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MusicPack Author",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
