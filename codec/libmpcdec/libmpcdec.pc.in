prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libmpcdec
Description: Musepack (MPC) decoder library
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lmusepack
Libs.private: @MUSEPACK_PC_PRIVATE_LIBS@
Cflags: -I${includedir}
