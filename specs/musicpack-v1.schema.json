{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musicpack.dev/specs/musicpack-v1.schema.json",
  "title": "MusicPack .mpack v1 manifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["format", "version", "album", "media"],
  "properties": {
    "format": { "const": "musicpack" },
    "version": { "const": 1 },
    "album": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "artists"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "artists": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "role": { "type": "string" }
            }
          }
        },
        "releaseType": {
          "description": "Release type of the release group (album level). Never inferred from track count.",
          "type": "string",
          "enum": [
            "album",
            "ep",
            "single",
            "maxi-single",
            "compilation",
            "soundtrack",
            "live-album",
            "remix-album",
            "box-set",
            "other"
          ]
        },
        "originalReleaseDate": {
          "description": "First release date of the release group (ISO-8601).",
          "type": "string"
        },
        "genres": { "type": "array", "items": { "type": "string" } }
      }
    },
    "release": {
      "description": "The specific release/edition this package represents: a collectible digital object.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "releaseDate": {
          "description": "Release date of this specific release/edition (ISO-8601).",
          "type": "string"
        },
        "edition": { "type": "string" },
        "country": {
          "description": "Release country/territory; ISO 3166-1 alpha-2 is recommended (e.g. GB, US, XE).",
          "type": "string"
        },
        "label": { "type": "string" },
        "catalogueNumber": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "musicbrainzReleaseGroupId": {
          "description": "Release-group (album) identity; the abstract release the album belongs to.",
          "type": "string"
        },
        "musicbrainzReleaseId": {
          "description": "Specific release identity (this release/edition, not the release group).",
          "type": "string"
        },
        "barcode": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "enum": ["musicbrainz", "store", "local"] },
        "confidence": { "enum": ["exact", "confirmed", "probable", "none"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "store": { "type": "string" },
        "sourceId": { "type": "string" }
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["disc", "tracks"],
        "properties": {
          "disc": { "type": "integer", "minimum": 1 },
          "format": {
            "description": "Physical or digital medium format of this medium.",
            "type": "string",
            "enum": [
              "CD",
              "SACD",
              "Vinyl",
              "Cassette",
              "Digital",
              "Blu-ray Audio",
              "DVD-Audio",
              "Other"
            ]
          },
          "title": { "type": "string" },
          "tracks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["track", "title", "audio"],
              "properties": {
                "track": { "type": "integer", "minimum": 1 },
                "title": { "type": "string", "minLength": 1 },
                "artists": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "required": ["name"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1 },
                      "role": { "type": "string" }
                    }
                  }
                },
                "identifiers": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "isrc": { "type": "string" },
                    "musicbrainzTrackId": { "type": "string" },
                    "musicbrainzRecordingId": { "type": "string" }
                  }
                },
                "source": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "store": { "type": "string" },
                    "trackId": { "type": "string" }
                  }
                },
                "sourceAudio": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "codec": { "type": "string" },
                    "md5": { "type": "string" }
                  }
                },
                "duration": { "type": "number", "exclusiveMinimum": 0 },
                "loudness": {
                  "description": "Per-track BS.1770-5 measured loudness.",
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["trackLUFS", "truePeakDbTP"],
                  "properties": {
                    "trackLUFS": {
                      "description": "Integrated loudness in dB LUFS (ITU-R BS.1770-5).",
                      "type": "number"
                    },
                    "truePeakDbTP": {
                      "description": "True peak in dBTP (ITU-R BS.1770-5, 4x oversampling).",
                      "type": "number"
                    }
                  }
                },
                "audio": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "codec": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "artwork": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["role", "path"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "booklet": { "$ref": "#/$defs/assetArray" },
    "lyrics": { "$ref": "#/$defs/assetArray" },
    "extras": { "$ref": "#/$defs/assetArray" },
    "analysis": {
      "description": "Optional references to analysis documents stored in the package (e.g. sonic audio embeddings). The manifest only references them; it never embeds their payload.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "profile": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "loudness": {
      "description": "Album (program) loudness, measured by feeding all tracks in order through one meter.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "algorithm": {
          "description": "Loudness algorithm revision used for the measured values.",
          "type": "string"
        },
        "albumLUFS": {
          "description": "Integrated loudness over the whole album program in dB LUFS (ITU-R BS.1770-5).",
          "type": "number"
        },
        "albumTruePeakDbTP": {
          "description": "Maximum relevant true peak across the album program in dBTP (ITU-R BS.1770-5).",
          "type": "number"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "tool": { "type": "string" },
        "toolVersion": { "type": "string" }
      }
    }
  },
  "$defs": {
    "assetArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
