# Optional environment template for musicpack-server.
#
# Copy to /etc/musicpack/musicpack-server.env when you want to configure the
# service through environment variables instead of editing ExecStart.
#
# Precedence: command-line flags > environment variables > defaults. The
# systemd unit's ExecStart sets the library/database/listen/port explicitly,
# so if you enable these variables you must remove the matching flags from
# ExecStart (--static-dir has no environment equivalent and stays explicit).

# MUSICPACK_LIBRARY=/srv/musicpack/library
# MUSICPACK_DATABASE=/srv/musicpack/data/library.db
# MUSICPACK_LISTEN=127.0.0.1
# MUSICPACK_PORT=8080

# Log level: error | warn | info | debug
MUSICPACK_LOG=info
